{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "backend/api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 10 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/backend/api/:path*" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
